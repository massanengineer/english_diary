<div class="stats">
  <div class="stat">
    <span class="stat-num"><%= @total_entries %></span>
    <span class="stat-label">総記録日数</span>
  </div>
  <div class="stat">
    <span class="stat-num"><%= @streak %></span>
    <span class="stat-label">連続記録日数</span>
  </div>
  <div class="stat">
    <span class="stat-num"><%= @vocabulary_count %></span>
    <span class="stat-label">学習した単語数</span>
  </div>
</div>

<div class="page-actions">
  <h1>日記一覧</h1>
  <div>
    <%= link_to "カレンダーで見る", calendar_path, class: "btn-secondary" %>
    <%= link_to "新規作成", new_diary_entry_path, class: "btn-primary" %>
  </div>
</div>

<ul class="entry-list">
  <% @diary_entries.each do |entry| %>
    <li class="entry-card">
      <%= link_to diary_entry_path(entry), class: "entry-card-link" do %>
        <span class="entry-date"><%= entry.entry_date.strftime("%Y年%m月%d日") %></span>
        <span class="entry-snippet"><%= truncate(entry.content, length: 40) %></span>
        <% if entry.english_content.present? %>
          <span class="badge-translated">英訳済み</span>
        <% else %>
          <span class="badge-untranslated">未変換</span>
        <% end %>
      <% end %>
    </li>
  <% end %>
</ul>
