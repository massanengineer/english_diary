<div class="stats">
  <div class="stat">
    <span class="stat-num"><%= @total_entries %></span>
    <span class="stat-label">総記録日数</span>
  </div>
  <div class="stat">
    <span class="stat-num"><%= @streak %></span>
    <span class="stat-label">連続記録日数</span>
  </div>
  <div class="stat">
    <span class="stat-num"><%= @vocabulary_count %></span>
    <span class="stat-label">学習した単語数</span>
  </div>
</div>

<%= link_to "カレンダーで見る", calendar_path %>

<h1>日記一覧</h1>

<%= link_to "新規作成", new_diary_entry_path %>

<ul>
  <% @diary_entries.each do |entry| %>
    <li>
      <%= link_to entry.entry_date, diary_entry_path(entry) %>
    </li>
  <% end %>
</ul>
